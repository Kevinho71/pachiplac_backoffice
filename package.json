{
  "name": "pachiplac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:backend": "pnpm --filter @pachiplac/backend build",
    "build:frontend": "pnpm --filter @pachiplac/frontend build",
    "dev:backend": "pnpm --filter @pachiplac/backend start:dev",
    "dev:frontend": "pnpm --filter @pachiplac/frontend dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
