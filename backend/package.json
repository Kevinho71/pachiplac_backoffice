{
  "name": "@pachiplac/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de PACHIPLAC (cortes, ventas e inventario de melaminas)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "test": "vitest run --passWithNoTests",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "16.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
