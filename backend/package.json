{
  "name": "@pachiplac/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de PACHIPLAC (cortes, ventas e inventario de melaminas)",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prebuild": "pnpm prisma:generate",
    "pretypecheck": "pnpm prisma:generate",
    "pretest": "pnpm prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "test": "vitest run --passWithNoTests",
    "db:seed": "prisma db seed && tsx src/seed/crear-usuario.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@pachiplac/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "16.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
