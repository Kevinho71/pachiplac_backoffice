# Copiar a .env y ajustar. El .env NO se commitea.

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://pachiplac:pachiplac_dev@localhost:5445/pachiplac?schema=public"

# --- Autenticación (JWT en cookie httpOnly) ---
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- MinIO / S3 (fotos y PDFs) ---
MINIO_ENDPOINT=http://localhost:9010
MINIO_BUCKET=pachiplac
MINIO_ACCESS_KEY=pachiplac
MINIO_SECRET_KEY=pachiplac_dev_secret

# --- IA (importación por foto, Claude API) ---
ANTHROPIC_API_KEY=
