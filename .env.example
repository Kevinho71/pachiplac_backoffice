# Copiar a .env y ajustar si hace falta. El .env NO se commitea.

# --- PostgreSQL local (docker compose) ---
POSTGRES_USER=pachiplac
POSTGRES_PASSWORD=pachiplac_dev
POSTGRES_DB=pachiplac
POSTGRES_PORT=5445
DATABASE_URL="postgresql://pachiplac:pachiplac_dev@localhost:5445/pachiplac?schema=public"

# --- MinIO local (S3 para fotos y PDFs) ---
MINIO_ROOT_USER=pachiplac
MINIO_ROOT_PASSWORD=pachiplac_dev_secret
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=http://localhost:9010
MINIO_BUCKET=pachiplac
